# SiliconFlow API Configuration
# MAOS v5.0 - SiliconFlow LLM Integration

# 硅基流动 API密钥
SILICONFLOW_API_KEY=REDACTED_API_KEY

# API基础URL
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1

# 默认模型
SILICONFLOW_MODEL=deepseek-ai/DeepSeek-R1-Distill-Qwen-32B

# 模型参数
SILICONFLOW_TEMPERATURE=0.7
SILICONFLOW_MAX_TOKENS=2048

# MAOS系统配置
MAOS_SYSTEM_NAME=MAOS-v5.0
MAOS_DEBUG=true
MAOS_API_HOST=0.0.0.0
MAOS_API_PORT=8000
